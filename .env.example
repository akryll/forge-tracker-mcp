# Ключ агента. Выдаёт человек на странице /agents в Forge, начинается с fga_.
FORGE_AGENT_KEY=fga_...

# Либо путь к файлу с ключом, если держать секрет в переменной неудобно.
# FORGE_AGENT_KEY_FILE=/home/user/.config/forge/agent-key

# Адрес API Forge. По умолчанию — локальная разработка.
# FORGE_API_URL=http://localhost:8090/api/v1

# Потолок на один запрос к Forge, мс.
# FORGE_TIMEOUT_MS=15000

# Потолок на скриншот, байт. По умолчанию 10 МБ — столько же принимает Forge.
# FORGE_MAX_SCREENSHOT_BYTES=10485760
