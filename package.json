{
  "name": "forge-tracker-mcp",
  "version": "0.1.0",
  "description": "MCP-сервер поверх агентского API Forge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akryll/forge-mcp-client.git"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "forge",
    "tasks",
    "agent"
  ],
  "type": "module",
  "bin": {
    "forge-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.11"
  }
}
